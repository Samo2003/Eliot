                {% else %}
                {% if src_bytes %}
                static constexpr uint8_t SRC_IP[] = { {{ src_bytes | map('int') | join(', ') }} };
                // SRC IP offset
                if (memcmp(&p[8], SRC_IP, IPv6_ADDR_LEN) != 0)
