            {% set ip_bytes = guard.convert(guard.ip) if guard.ip is not none else none %}
            {% set src_bytes = guard.convert(guard.src) if guard.src is not none else none %}                
            {% set dst_bytes = guard.convert(guard.dst) if guard.dst is not none else none %}
