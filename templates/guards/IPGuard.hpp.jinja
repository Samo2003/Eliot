                {% endif %}

                {% if dst_bytes %}
                static constexpr uint8_t DST_IP[] = { {{ dst_bytes | map('int') | join(', ') }} };
                // DST IP offset
                if (memcmp(&p[24], DST_IP, IPv6_ADDR_LEN) != 0)
