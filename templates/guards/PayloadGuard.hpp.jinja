#ifndef {{ guard.hpp_define() }}
#define {{ guard.hpp_define() }}

#include <cstring>
#include <algorithm>
#include "../Packet.hpp"

namespace eliot_generated {
    struct {{ guard.cpp_type() }} {
        static inline bool fulfilled(const Packet* packet) noexcept {
            const uint8_t* data = packet->payload().data();
            const size_t size = packet->size();

            size_t layer_beg = 0;

            {% if guard.l4 %}
            const int offset = packet->l4_offset();
            if (offset < 0 || (size_t)offset >= size)
                return false;
            layer_beg = static_cast<size_t>(offset);
            {% endif %}

            const size_t layer_len = size - layer_beg;

            {% if guard.start < 0 %}
            constexpr int start_offset = {{ guard.start }};
            ssize_t beg_rel = static_cast<ssize_t>(layer_len) + start_offset;
            {% else %}
            ssize_t beg_rel = {{ guard.start }};
            {% endif %}

            {% if guard.end is not none %}
            {% if guard.end < 0 %}
            constexpr int end_offset = {{ guard.end }};
            ssize_t end_rel = static_cast<ssize_t>(layer_len) + end_offset;
            {% else %}
            ssize_t end_rel = {{ guard.end }};
            {% endif %}
            {% else %}
            ssize_t end_rel = static_cast<ssize_t>(layer_len);
            {% endif %}

            beg_rel = std::clamp(beg_rel, ssize_t{0}, static_cast<ssize_t>(layer_len));
            end_rel = std::clamp(end_rel, ssize_t{0}, static_cast<ssize_t>(layer_len));

            if (beg_rel >= end_rel)
                return false;

            const size_t begin = layer_beg + static_cast<size_t>(beg_rel);
            const size_t end = layer_beg + static_cast<size_t>(end_rel);

            const size_t window_length = end - begin;
            if (window_length < _pattern_len)
                return false;

            const uint8_t* window = data + begin;

            {% if guard.pattern | length == 1 %}
            return std::memchr(window, _pattern[0], window_length) != nullptr;
            {% else %}
#if defined(__GLIBC__)
            return std::memmem(window, window_length, _pattern, _pattern_len) != nullptr;
#else
            return std::search(window, window + window_length, _pattern, _pattern + _pattern_len) != window + window_length;
#endif            
            {% endif %}
        }

        private:
            static constexpr uint8_t _pattern[] = {
                {%- for b in guard.pattern -%}
                0x{{ "%02X"|format(b) }}{{ ", " if not loop.last }}
                {%- endfor -%}
            };

            static constexpr size_t _pattern_len = {{ guard.pattern | length }};
    };

}

#endif
