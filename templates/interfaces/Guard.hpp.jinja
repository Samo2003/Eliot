#ifndef ELIOT_GUARD_H
#define ELIOT_GUARD_H

#include "../Packet.hpp"
#include <concepts>

namespace eliot_generated {
    template<typename T>
    concept GuardConcept = 
        requires(T guard, const Packet* packet) {
            { guard.fulfilled(packet) } -> std::convertible_to<bool>;
        } || 
        requires(const Packet* packet) {
            { T::fulfilled(packet) } -> std::convertible_to<bool>;
        };

    template<GuardConcept G>
    inline bool evaluate_guard(G& guard, const Packet* packet) noexcept {
        return guard.fulfilled(packet);
    }

    template<GuardConcept G>
    inline bool evaluate_guard(const Packet* packet) noexcept {
        return G::fulfilled(packet);
    }
}

#endif
