#ifndef ELIOT_PROCESSOR_H
#define ELIOT_PROCESSOR_H

#include "Packet.hpp"
#include "static/interfaces/State.hpp"
#include "static/interfaces/Guard.hpp"
#include "static/interfaces/Action.hpp"
{% if require_calendar %}
#include "static/calendar/Calendar.hpp"
{% endif %}
{% for state in states %}
#include "states/{{ state.cpp_type() }}.hpp"
{% endfor %}
{% for guard in guards %}
#include "guards/{{ guard.cpp_type() }}.hpp"
{% endfor %}
{% for action in actions %}
#include "actions/{{ action.cpp_type() }}.hpp"
{% endfor %}

namespace eliot_generated {
    struct Processor {
        void process_packet(Packet* packet) noexcept;

        {% if require_calendar %}
        Calendar calendar;
        {% endif %}

        private: 
{% for state in states %}
            {{ state.cpp_type() }} {{ state.cpp_name() }};
{% endfor %}
{% for guard in guards %}
            {% if guard.is_state() %}
            {{ guard.cpp_type() }} {{ guard.cpp_name() }}{{ guard.init() }};
            {% endif %}
{% endfor %}
{% for action in actions %}
            {% if action.is_state() %}
            {{ action.cpp_type() }} {{ action.cpp_name() }}{{ action.init() }};
            {% endif %}
{% endfor %}
    };

}

#endif
