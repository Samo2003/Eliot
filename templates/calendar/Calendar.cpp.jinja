#include "Calendar.hpp"

namespace eliot_generated {
    void Calendar::schedule(Packet* packet, Delay delay) noexcept {
        Clock::time_point time = Clock::now() + delay;
        _queue.emplace(CalendarItem{ time, packet, _counter++ });
    }

    Packet* Calendar::get_ready() noexcept {
        if (_queue.empty())
            return nullptr;

        if (_queue.top().time <= Clock::now()) {
            auto packet = _queue.top().packet;
            _queue.pop();
            return packet;
        }

        return nullptr;
    }

    Calendar::~Calendar() {
        while (!_queue.empty()) {
            auto item = _queue.top();
            _queue.pop();
            delete item.packet;
        }
    }
}
