#ifndef {{ action.hpp_define() }}
#define {{ action.hpp_define() }}

#include <vector>
{% if action.strategy == "random" %}
#include <random>
{% endif %}
#include <algorithm>
#include "../Packet.hpp"
#include "../calendar/Calendar.hpp"

namespace eliot_generated {
    struct {{ action.cpp_type() }} {
        explicit {{ action.cpp_type() }}(Calendar& calendar) : _calendar(calendar) { 
            _buffer.reserve(_n);
        }

        inline void execute(Packet& packet) noexcept {
            _buffer.push_back(std::move(packet));

            if (_buffer.size() == _n) {
                {% if action.strategy == "random" %}
                std::shuffle(_buffer.begin(), _buffer.end(), _generator);
                {% else %}
                std::reverse(_buffer.begin(), _buffer.end());
                {% endif %}

                for (Packet& packet : _buffer) {
                    _calendar.schedule(std::move(packet), _delay);
                }

                _buffer.clear();
            }
        }

        private:
            Calendar& _calendar;
            std::vector<Packet> _buffer;
            static constexpr int _n = {{ action.n }};
            static constexpr std::chrono::milliseconds _delay{0};
            {% if action.strategy == "random" %}
            std::mt19937 _generator{ std::random_device{}() };
            {% endif %}
    };
}

#endif
