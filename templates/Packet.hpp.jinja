#ifndef ELIOT_PACKET_H
#define ELIOT_PACKET_H

#include {{ api.include() }}
#include <vector>

namespace eliot_generated {
    enum class PacketResult { Drop, Finish, Calendar };

    struct Packet {
        explicit inline Packet({{ api.packet_type() }}&& packet) noexcept 
            : _packet(std::move(packet)) {}

        inline {{ api.packet_type() }}&& move_packet() noexcept { return std::move(_packet); }
        
        inline const std::vector<uint8_t>& payload() const noexcept { return _packet.{{ api.packet_payload() }}; }

        inline const size_t size() const noexcept { return payload().size(); }

        inline const int version() const noexcept { return size() == 0 ? -1 : (payload()[0]) >> 4; }

        inline const int protocol() const noexcept { 
            if (_protocol == -1)
                _protocol = _get_protocol();
            return _protocol;
        }

        inline const int l4_offset() const noexcept { 
            if (_l4_offset != -1)
                return _l4_offset;
            
            int v = version();
            if (v == 4) {
                if (size() < 20)
                    return -1;

                int header_len = ((payload()[0]) & 0x0F) * 4;
                if (header_len < 20 || (size_t)header_len > size())
                    return -1;

                _l4_offset = header_len;
                return _l4_offset;
            } else if (v == 6) {
                const std::vector<uint8_t>& p = payload();
                uint8_t next = p[6];
                size_t offset = 40;

                while (true) {
                    switch (next) {
                        case 0:     // Hop-by-Hop option
                        case 43:    // Routing
                        case 44:    // Fragment
                        case 50:    // ESP
                        case 51:    // AH
                        case 60:    // Destination options
                            break;
                        default:
                            _l4_offset = offset;
                            return offset;
                    }
                    
                    // Next-header first byte, header len second byte
                    if (offset + 2 > size())
                        return -1;

                    uint8_t len = p[offset + 1];
                    // Len dos not include first octet
                    size_t header_size = (len + 1) * 8;

                    if (offset + header_size > size())
                        return -1;

                    next = p[offset];
                    offset += header_size;
                }
            }

            return -1;
        }
        
        int state = 0;

        private:
            {{ api.packet_type() }} _packet;

            mutable int _protocol = -1;
            mutable int _l4_offset = -1;

            inline const int _get_protocol() const noexcept {
                int v = version();
                if (v == -1)
                    return -1;

                const std::vector<uint8_t>& p = payload();

                if (v == 4) {
                    // IPv4 header size
                    if (size() < 20)
                        return -1;

                    // Protocol field
                    return p[9];
                }

                if (v == 6) {
                    // IPv6 header size
                    if (size() < 40)
                        return -1;
                    
                    // Next Header field
                    return p[6];
                }

                // Invalid protocol version
                return -1;
            }
    };

}

#endif
