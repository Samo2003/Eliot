#ifndef ELIOT_PACKET_H
#define ELIOT_PACKET_H

#include "{{ traits }}"
#include <optional>
#include <vector>
#include "static/ItemPool.hpp"
#include "static/interfaces/Traits.hpp"

namespace eliot_generated {
    static_assert(BackendTraitsConcept<ActiveTraits>, "ActiveTraits does not satisfy BackendTraits concept");

    enum class PacketResult { Drop, Finish, Calendar, Processing };

    template<BackendTraitsConcept Traits>
    struct InternalPacket {
        using PacketType = typename Traits::PacketType;

        explicit inline InternalPacket(PacketType&& packet) noexcept 
            : _packet(std::move(packet)) {}

        static inline InternalPacket* acquire(PacketType&& packet) {
            return _packet_pool().acquire(std::move(packet));
        }

        static inline void release(InternalPacket *p) noexcept {
            _packet_pool().release(p);
        }

        inline InternalPacket* clone() {
            auto new_packet = Traits::clone(_packet);
            auto* p = acquire(std::move(new_packet));

            if (_local_payload)
                p->_local_payload = *_local_payload;

            p->state = state;
            p->result = PacketResult::Processing;

            return p;
        }

        inline PacketType move_packet() noexcept { 
            if constexpr (!Traits::modifiable_payload) {
                if (_local_payload) {
                    _packet = Traits::change_payload(
                        std::move(_packet),
                        std::move(*_local_payload)
                    );
                }
            }
            return std::move(_packet);
        }
        
        inline const std::vector<uint8_t>& payload() const noexcept { 
            return Traits::payload(_packet); 
        }

        inline std::vector<uint8_t>& mutable_payload() noexcept { 
            _invalidate_cache();
            if constexpr (Traits::modifiable_payload) {
                return Traits::mutable_payload(_packet);
            } else {
                if (!_local_payload)
                    _local_payload = Traits::payload(_packet);
                return *_local_payload;
            }
        }

        inline const size_t size() const noexcept { return payload().size(); }

        inline const int version() const noexcept { 
            const std::vector<uint8_t>& p = payload();
            return p.size() == 0 ? -1 : (p[0]) >> 4; 
        }

        inline const int protocol(bool nh_only = false) const noexcept {
            _ensure_l4_parsed();
            return nh_only && version() == 6 ? _nh : _l4_protocol;
        }

        inline const int l4_offset() const noexcept {
            _ensure_l4_parsed();
            return _l4_offset;
        }
        
        unsigned state = 0;

        PacketResult result = PacketResult::Processing;

        private:
            PacketType _packet;
            std::optional<std::vector<uint8_t>> _local_payload;

            mutable int _l4_protocol = -1;
            mutable int _l4_offset = -1;
            mutable int _nh = -1;
            mutable bool _l4_parsed = false;

            inline void _invalidate_cache() noexcept {
                _l4_parsed = false;
                _l4_protocol = -1;
                _l4_offset = -1;
                _nh = -1;
            }

            static inline ItemPool<InternalPacket<Traits>>& _packet_pool() {
                static ItemPool<InternalPacket<Traits>, 4096> pool;
                return pool;
            }

            static void* operator new(std::size_t) = delete;
            static void  operator delete(void*) = delete;
            static void* operator new[](std::size_t) = delete;
            static void  operator delete[](void*) = delete;

            inline void _parse_l4() const noexcept {
                const std::vector<uint8_t>& p = payload();
                const size_t sz = p.size();
                const int v = version();

                if (v == 4) {
                    // IPv4 header size
                    if (sz < 20)
                        return;

                    int header_len = (p[0] & 0x0F) * 4;
                    if (header_len < 20 || (size_t)header_len > sz)
                        return;

                    _l4_offset = header_len;
                    // Protocol field
                    _l4_protocol = p[9];
                } else if (v == 6) {
                    if (sz < 40)
                        return;

                    uint8_t next = p[6];
                    _nh = next;
                    size_t offset = 40;

                    while (true) {
                        switch (next) {
                            case 0:     // Hop-by-Hop option
                            case 43:    // Routing
                            case 44:    // Fragment
                            case 50:    // ESP
                            case 51:    // AH
                            case 60:    // Destination options
                                break;
                            default:
                                _l4_offset = static_cast<int>(offset);
                                _l4_protocol = static_cast<int>(next);
                                return;
                        }
                        
                        // Next-header first byte, header len second byte
                        if (offset + 2 > sz)
                            return;

                        uint8_t len = p[offset + 1];
                        // Len does not include first octet
                        size_t header_size = (len + 1) * 8;

                        if (offset + header_size > sz)
                            return;

                        next = p[offset];
                        offset += header_size;
                    }
                }
            }

            inline void _ensure_l4_parsed() const noexcept {
                if (_l4_parsed)
                    return;

                _parse_l4();
                _l4_parsed = true;
            }
    };

    using Packet = InternalPacket<ActiveTraits>;
}

#endif
